# Shared default model/provider (used when an agent-specific value is absent)
AETHER_MODEL=ollama/qwen2.5:7b
AETHER_API_BASE=http://127.0.0.1:11434
AETHER_API_KEY=

# Optional independent model configuration per agent
AETHER_ANALYST_MODEL=ollama/qwen2.5:7b
AETHER_ANALYST_API_BASE=http://127.0.0.1:11434
AETHER_ANALYST_API_KEY=

AETHER_FIXER_MODEL=ollama/qwen2.5:7b
AETHER_FIXER_API_BASE=http://127.0.0.1:11434
AETHER_FIXER_API_KEY=

AETHER_SCOUT_MODEL=ollama/qwen2.5:7b
AETHER_SCOUT_API_BASE=http://127.0.0.1:11434
AETHER_SCOUT_API_KEY=

AETHER_AUDITOR_MODEL=ollama/qwen2.5:7b
AETHER_AUDITOR_API_BASE=http://127.0.0.1:11434
AETHER_AUDITOR_API_KEY=

AETHER_DATABASE=~/.aether-core/aether.db
AETHER_LOG_LEVEL=INFO
